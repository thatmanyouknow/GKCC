{
  "version": 3,
  "title": "Klipper configuration builder",
  "sources": {
    "klipper": "https://www.klipper3d.org/Config_Reference.html",
    "ellis": "https://ellis3dp.com/Print-Tuning-Guide/",
    "happy_hare": "https://github.com/moggieuk/Happy-Hare/wiki"
  },
  "groups": [
    {
      "id": "identity",
      "title": "1. Printer identity and controller",
      "summary": "Name the machine, choose its kinematics, and identify the main MCU.",
      "diagram": "printer",
      "fields": [
        {
          "key": "meta.printer_name",
          "label": "Printer name",
          "type": "text",
          "required": true,
          "placeholder": "Voron V2.4 350"
        },
        {
          "key": "printer.kinematics",
          "section": "printer",
          "option": "kinematics",
          "label": "Kinematics",
          "type": "select",
          "required": true,
          "options": [
            "corexy",
            "cartesian",
            "corexz",
            "delta",
            "hybrid_corexy",
            "hybrid_corexz",
            "none"
          ]
        },
        {
          "key": "mcu.serial",
          "section": "mcu",
          "option": "serial",
          "label": "Main MCU serial",
          "type": "text",
          "required": true,
          "placeholder": "/dev/serial/by-id/..."
        },
        {
          "key": "mcu.canbus_uuid",
          "section": "mcu",
          "option": "canbus_uuid",
          "label": "Main MCU CAN UUID",
          "type": "text",
          "placeholder": "Use instead of serial when applicable"
        },
        {
          "key": "printer.max_velocity",
          "section": "printer",
          "option": "max_velocity",
          "label": "Maximum velocity (mm/s)",
          "type": "number",
          "required": true,
          "min": 1,
          "step": 1
        },
        {
          "key": "printer.max_accel",
          "section": "printer",
          "option": "max_accel",
          "label": "Maximum acceleration (mm/s\u00b2)",
          "type": "number",
          "required": true,
          "min": 1,
          "step": 1
        },
        {
          "key": "printer.max_z_velocity",
          "section": "printer",
          "option": "max_z_velocity",
          "label": "Maximum Z velocity (mm/s)",
          "type": "number",
          "required": true,
          "min": 1,
          "step": 0.1
        },
        {
          "key": "printer.max_z_accel",
          "section": "printer",
          "option": "max_z_accel",
          "label": "Maximum Z acceleration (mm/s\u00b2)",
          "type": "number",
          "required": true,
          "min": 1,
          "step": 1
